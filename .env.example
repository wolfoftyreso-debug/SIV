# Root env example (local dev)
#
# In production, split between:
# - DATABASE_MIGRATION_URL (admin/owner for migrations)
# - DATABASE_URL (runtime app role, e.g. pixdrift_app)
#
# Neon Postgres should be provisioned via Vercel Marketplace.

# Database (Neon)
DATABASE_URL=
DATABASE_MIGRATION_URL=
EMPLOYMENT_CASES_DB_MODE=memory
DATABASE_SSL_MODE=

# Dev auth/tenant context (development only)
DEV_TENANT_ID=
DEV_ACTOR_ID=
DEV_ROLES=tenant_owner,case_admin

# DB app role (development helper)
PIXDRIFT_APP_DB_PASSWORD=pixdrift_app_pw

# Security / operational
CRON_SECRET=
AUDIT_HASH_KEY=

